{
  "manifest_version": 3,
  "name": "Comment Fold for GitHub",
  "short_name": "Comment Fold",
  "version": "0.2.1",
  "description": "Fold away code comments in GitHub pull requests, commits and compares, so you can review just the code.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
